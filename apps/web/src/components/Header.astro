---
/**
 * Header behavior:
 * - Transparent over hero
 * - White nav wrap centered (Jobs/Tools/Learn/Events/About)
 * - Left Home, Right CTA Get Started
 * - Liquid glass hover on nav items
 * - Turns white when scrolled past hero
 */
---

<header class="hdr" id="siteHeader">
  <div class="hdrInner">
    <!-- Left: Home -->
    <a class="home" href="/" aria-label="Jhub Home">Jhub</a>

    <!-- Center: nav wrap -->
    <nav class="navWrap" aria-label="Primary navigation">
      <a class="navItem" href="/jobs">Jobs</a>
      <a class="navItem" href="/tools">Tools</a>
      <a class="navItem" href="/learn">Learn</a>
      <a class="navItem" href="/events">Events</a>
      <a class="navItem" href="/about">About</a>
    </nav>

    <!-- Right: CTA -->
    <a class="cta" href="/tools/apply">Get Started</a>
  </div>

  <script is:inline>
    (function () {
      const header = document.getElementById("siteHeader");
      const hero = document.getElementById("hero");
      if (!header || !hero) return;

      function onScroll() {
        const heroBottom = hero.getBoundingClientRect().bottom;
        // when hero is mostly out of view, switch header to white
        if (heroBottom <= 72) header.classList.add("scrolled");
        else header.classList.remove("scrolled");
      }

      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
    })();
  </script>

  <style>
    .hdr{
      position: sticky;
      top: 0;
      z-index: 50;
      background: transparent;
      transition: background-color .18s ease, border-color .18s ease;
      border-bottom: 1px solid transparent;
    }

    /* when scrolled past hero */
    .hdr.scrolled{
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom-color: var(--border);
    }

    .hdrInner{
      max-width: 1240px;
      margin: 0 auto;
      padding: 14px 22px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 14px;
    }

    .home{
      justify-self: start;
      text-decoration: none;
      color: var(--ink);
      font-weight: 780;
      letter-spacing: -0.02em;
    }
    .home:hover{ text-decoration: none; opacity: 0.9; }

    /* center nav wrap is white even when header is transparent */
    .navWrap{
      justify-self: center;
      display: flex;
      gap: 6px;
      padding: 6px;
      background: rgba(255,255,255,0.92);
      border: 1px solid var(--border);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .navItem{
      position: relative;
      padding: 9px 12px;
      text-decoration: none;
      color: var(--ink);
      font-weight: 650;
      font-size: 14px;
      border: 1px solid transparent;
      background: transparent;
      transition: transform .14s ease, border-color .14s ease, background .14s ease, box-shadow .14s ease;
    }

    /* liquid glass hover */
    .navItem:hover{
      transform: translateY(-1px);
      border-color: rgba(255,255,255,0.35);
      background: rgba(255,255,255,0.28);
      box-shadow:
        0 12px 30px rgba(2,6,23,0.08),
        inset 0 1px 0 rgba(255,255,255,0.28);
      text-decoration: none;
    }

    .cta{
      justify-self: end;
      text-decoration: none;
      color: #fff;
      font-weight: 700;
      padding: 10px 14px;
      border: 1px solid rgba(15,118,110,0.55);
      background: rgba(15,118,110,0.92);
      transition: transform .14s ease, box-shadow .14s ease, filter .14s ease;
    }
    .cta:hover{
      transform: translateY(-1px);
      box-shadow: 0 16px 44px rgba(15,118,110,0.22);
      filter: saturate(1.05);
      text-decoration: none;
    }

    @media (max-width: 860px){
      .hdrInner{
        grid-template-columns: auto 1fr auto;
        gap: 10px;
      }
      .navWrap{
        justify-self: center;
        overflow-x: auto;
        max-width: 100%;
      }
    }

    @media (max-width: 640px){
      .hdrInner{ padding: 12px 16px; }
      .cta{ padding: 10px 12px; }
      .navItem{ padding: 9px 10px; }
    }
  </style>
</header>
