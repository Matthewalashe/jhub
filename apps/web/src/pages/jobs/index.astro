---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { jobs } from "../../data/jobs";

const title = "Jobs — Jhub";
---

<BaseLayout title={title}>
  <section class="wrap">
    <header class="head">
      <div>
        <h1 class="h1">Find jobs in Nigeria</h1>
        <p class="sub">Search, filter, and apply faster with Apply Kit.</p>
      </div>

      <nav class="quick">
        <a class="pill" href="/tools">Tools</a>
        <a class="pill" href="/tools/apply">Apply Kit</a>
      </nav>
    </header>

    <div class="controls">
      <label class="field">
        <span class="label">Search</span>
        <input id="q" class="input" placeholder="Role, company, or location…" autocomplete="off" />
      </label>

      <label class="field">
        <span class="label">Work mode</span>
        <select id="mode" class="select">
          <option value="">All</option>
          <option value="Remote">Remote</option>
          <option value="Hybrid">Hybrid</option>
          <option value="On-site">On-site</option>
        </select>
      </label>

      <label class="field">
        <span class="label">Level</span>
        <select id="level" class="select">
          <option value="">All</option>
          <option value="Entry">Entry</option>
          <option value="Mid">Mid</option>
          <option value="Senior">Senior</option>
        </select>
      </label>

      <label class="field">
        <span class="label">Location</span>
        <select id="loc" class="select">
          <option value="">All</option>
          <option value="Lagos">Lagos</option>
          <option value="Abuja">Abuja</option>
          <option value="Remote (Nigeria)">Remote (Nigeria)</option>
        </select>
      </label>
    </div>

    <div class="meta">
      <span id="count" class="count"></span>
      <button id="clear" class="linkbtn" type="button">Clear filters</button>
    </div>

    <div id="list" class="grid">
      {jobs.map((job) => (
        <article class="card" data-title={job.title} data-company={job.company} data-location={job.location} data-mode={job.workMode} data-level={job.level}>
          <div class="cardTop">
            <h2 class="h2">
              <a class="jobLink" href={`/jobs/${job.slug}`}>{job.title}</a>
            </h2>
            <span class="badge">{job.workMode}</span>
          </div>

          <div class="line">
            <span class="strong">{job.company}</span>
            <span class="dot">•</span>
            <span class="muted">{job.location}</span>
          </div>

          <div class="line">
            <span class="chip">{job.level}</span>
            <span class="chip">Deadline: {job.deadline}</span>
          </div>

          <p class="desc">{job.summary}</p>

          <div class="actions">
            <a class="btn" href={`/jobs/${job.slug}`}>Open</a>
            <a class="btn alt" href={`/tools/apply?job=${job.slug}`}>Apply Kit</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script type="module">
    const $ = (id) => document.getElementById(id);

    const q = $("q");
    const mode = $("mode");
    const level = $("level");
    const loc = $("loc");
    const list = $("list");
    const count = $("count");
    const clear = $("clear");

    function norm(s) { return (s || "").toLowerCase().trim(); }

    function applyFilters() {
      const query = norm(q.value);
      const m = mode.value;
      const lv = level.value;
      const l = loc.value;

      let visible = 0;
      const cards = list.querySelectorAll(".card");

      cards.forEach((card) => {
        const title = norm(card.dataset.title);
        const company = norm(card.dataset.company);
        const location = norm(card.dataset.location);

        const matchesQuery = !query || title.includes(query) || company.includes(query) || location.includes(query);
        const matchesMode = !m || card.dataset.mode === m;
        const matchesLevel = !lv || card.dataset.level === lv;
        const matchesLoc = !l || card.dataset.location === l;

        const show = matchesQuery && matchesMode && matchesLevel && matchesLoc;
        card.style.display = show ? "" : "none";
        if (show) visible++;
      });

      count.textContent = visible === 1 ? "1 job" : `${visible} jobs`;
    }

    [q, mode, level, loc].forEach((el) => el.addEventListener("input", applyFilters));
    clear.addEventListener("click", () => {
      q.value = "";
      mode.value = "";
      level.value = "";
      loc.value = "";
      applyFilters();
    });

    applyFilters();
  </script>

  <style>
    .wrap{
      max-width: 1120px;
      margin: 0 auto;
      padding: 28px 28px 64px;
    }

    .head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:16px;
      padding-bottom: 14px;
      border-bottom: 1px solid #e5e7eb;
    }

    .h1{
      margin:0;
      font-size: 34px;
      letter-spacing: -0.02em;
      color:#0f172a;
    }
    .sub{
      margin:8px 0 0;
      color:#64748b;
      line-height:1.6;
    }

    .quick{ display:flex; gap:10px; flex-wrap:wrap; }
    .pill{
      border:1px solid #e5e7eb;
      padding:10px 12px;
      font-weight:800;
      text-decoration:none;
      color:#0f172a;
      background:#fff;
    }

    .controls{
      display:grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap:14px;
      padding: 16px 0;
    }

    .field{ display:flex; flex-direction:column; gap:6px; }
    .label{ font-size:12px; color:#64748b; font-weight:700; }

    .input,.select{
      width:100%;
      border:1px solid #e5e7eb;
      padding:12px 12px;
      outline:none;
      background:#fff;
      color:#0f172a;
    }
    .input:focus,.select:focus{ border-color:#14b8a6; }

    .meta{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding: 10px 0 18px;
    }
    .count{ color:#0f172a; font-weight:800; }
    .linkbtn{
      background:transparent;
      border:1px solid #e5e7eb;
      padding:10px 12px;
      font-weight:800;
      cursor:pointer;
    }

    .grid{
      display:grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap:14px;
    }

    .card{
      border:1px solid #e5e7eb;
      padding:16px;
      background:#fff;
      display:flex;
      flex-direction:column;
      gap:10px;
      min-height: 210px;
    }

    .cardTop{ display:flex; align-items:flex-start; justify-content:space-between; gap:10px; }
    .h2{ margin:0; font-size:16px; line-height:1.35; }
    .jobLink{ color:#0f172a; text-decoration:none; font-weight:900; }
    .jobLink:hover{ text-decoration:underline; }

    .badge{
      border:1px solid #99f6e4;
      padding:6px 10px;
      font-weight:900;
      color:#0f172a;
      background:#f0fdfa;
      white-space:nowrap;
    }

    .line{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .strong{ font-weight:900; color:#0f172a; }
    .muted{ color:#64748b; }
    .dot{ color:#94a3b8; }

    .chip{
      border:1px solid #fde68a;
      padding:6px 10px;
      font-weight:900;
      background:#fffbeb;
      color:#0f172a;
    }

    .desc{
      margin:0;
      color:#64748b;
      line-height:1.6;
      display:-webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow:hidden;
    }

    .actions{ margin-top:auto; display:flex; gap:10px; flex-wrap:wrap; }
    .btn{
      border:1px solid #14b8a6;
      padding:10px 12px;
      font-weight:900;
      text-decoration:none;
      color:#0f172a;
      background:#f0fdfa;
    }
    .btn.alt{
      border-color:#fb7185;
      background:#fff1f2;
    }

    @media (max-width: 980px){
      .controls{ grid-template-columns: 1fr 1fr; }
      .grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 640px){
      .wrap{ padding: 22px 16px 56px; }
      .head{ align-items:flex-start; flex-direction:column; }
      .controls{ grid-template-columns: 1fr; }
      .grid{ grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
