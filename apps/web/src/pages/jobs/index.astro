---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { jobs } from "../../data/jobs";
---

<BaseLayout title="Jobs — Jhub">
  <section class="wrap">
    <header class="top">
      <div>
        <div class="kicker">Nigeria job feed</div>
        <h1 class="title">Find jobs in Nigeria</h1>
        <p class="subtitle">Search, filter, and apply faster with Apply Kit.</p>
      </div>

      <div class="topActions">
        <a class="btn ghost" href="/tools">Tools</a>
        <a class="btn teal" href="/tools/apply">Apply Kit</a>
      </div>
    </header>

    <section class="filters" aria-label="Filters">
      <label class="field">
        <span class="label">Search</span>
        <input id="q" class="input" placeholder="Role, company, or location…" />
      </label>

      <label class="field">
        <span class="label">Work mode</span>
        <select id="workMode" class="select">
          <option value="">All</option>
          <option>Remote</option>
          <option>Hybrid</option>
          <option>On-site</option>
        </select>
      </label>

      <label class="field">
        <span class="label">Level</span>
        <select id="level" class="select">
          <option value="">All</option>
          <option>Entry</option>
          <option>Mid</option>
          <option>Senior</option>
        </select>
      </label>

      <label class="field">
        <span class="label">Location</span>
        <select id="location" class="select">
          <option value="">All</option>
          <option>Lagos</option>
          <option>Abuja</option>
          <option>Remote (Nigeria)</option>
        </select>
      </label>

      <button id="clear" class="btn ghost" type="button">Clear</button>
    </section>

    <div class="meta">
      <div><strong id="count"></strong> jobs</div>
      <a class="metaLink" href="/news">News</a>
      <a class="metaLink" href="/newsletter">Newsletter</a>
    </div>

    <section id="grid" class="grid" aria-label="Job results"></section>
  </section>

  <script type="module">
    const jobs = ${JSON.stringify(jobs)};
    const $ = (id) => document.getElementById(id);

    const q = $("q");
    const workMode = $("workMode");
    const level = $("level");
    const location = $("location");
    const clear = $("clear");
    const grid = $("grid");
    const count = $("count");

    function norm(s){ return (s || "").toLowerCase().trim(); }

    function matches(job){
      const query = norm(q.value);
      const qok =
        !query ||
        norm(job.title).includes(query) ||
        norm(job.company).includes(query) ||
        norm(job.location).includes(query);

      const wok = !workMode.value || job.workMode === workMode.value;
      const lok = !level.value || job.level === level.value;

      const locv = location.value;
      const cLok = !locv || norm(job.location).includes(norm(locv));

      return qok && wok && lok && cLok;
    }

    function pill(text){
      return `<span class="pill">${escapeHtml(text)}</span>`;
    }

    function escapeHtml(s){
      return (s || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function render(list){
      count.textContent = String(list.length);

      grid.innerHTML = list.map((j) => {
        const href = `/jobs/${j.slug}`;
        const applyHref = `/tools/apply?job=${j.slug}`;

        return `
          <article class="card">
            <div class="cardTop">
              <div>
                <a class="jobTitle" href="${href}">${escapeHtml(j.title)}</a>
                <div class="jobSub">${escapeHtml(j.company)} <span class="dot">•</span> ${escapeHtml(j.location)}</div>
              </div>
              <div class="tag">${escapeHtml(j.workMode)}</div>
            </div>

            <div class="cardMid">
              ${pill(j.level)}
              ${pill("Deadline: " + j.deadline)}
            </div>

            <p class="cardText">${escapeHtml(j.summary)}</p>

            <div class="cardActions">
              <a class="btn ghost" href="${href}">Open</a>
              <a class="btn teal" href="${applyHref}">Apply Kit</a>
            </div>
          </article>
        `;
      }).join("");
    }

    function run(){
      render(jobs.filter(matches));
    }

    [q, workMode, level, location].forEach(el => el.addEventListener("input", run));
    clear.addEventListener("click", () => {
      q.value = "";
      workMode.value = "";
      level.value = "";
      location.value = "";
      run();
    });

    run();
  </script>

  <style>
    .wrap{ max-width:1120px; margin:0 auto; padding:28px 28px 72px; }
    .top{ display:flex; justify-content:space-between; align-items:flex-end; gap:16px; padding-bottom:18px; border-bottom:1px solid #e5e7eb; }
    .kicker{ font-size:12px; font-weight:600; color:#0f766e; text-transform:uppercase; letter-spacing:.08em; }
    .title{ margin:8px 0 0; font-size:38px; line-height:1.1; color:#0f172a; font-weight:650; letter-spacing:-0.02em; }
    .subtitle{ margin:10px 0 0; color:#64748b; max-width:52ch; line-height:1.6; }
    .topActions{ display:flex; gap:10px; flex-wrap:wrap; }

    .filters{
      margin-top:16px;
      display:grid;
      grid-template-columns: 2fr 1fr 1fr 1fr auto;
      gap:10px;
      align-items:end;
    }
    .field{ display:flex; flex-direction:column; gap:6px; }
    .label{ font-size:12px; font-weight:600; color:#64748b; }
    .input,.select{
      border:1px solid #e5e7eb;
      padding:12px;
      background:#fff;
      color:#0f172a;
      outline:none;
    }
    .input:focus,.select:focus{ border-color:#0f766e; }

    .btn{
      border:1px solid #e5e7eb;
      padding:10px 12px;
      font-weight:600;
      background:#fff;
      color:#0f172a;
      cursor:pointer;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
    }
    .btn:hover{ border-color:#cbd5e1; text-decoration:none; }
    .btn.teal{
      border-color:#0f766e;
      background:#0f766e;
      color:#fff;
    }
    .btn.teal:hover{ filter:brightness(.97); }
    .btn.ghost{ background:#fff; }

    .meta{
      margin-top:14px;
      display:flex;
      gap:12px;
      align-items:center;
      color:#64748b;
    }
    .metaLink{ color:#0f766e; font-weight:600; }

    .grid{
      margin-top:16px;
      display:grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap:12px;
    }

    .card{
      border:1px solid #e5e7eb;
      background:#fff;
      padding:14px;
      display:flex;
      flex-direction:column;
      gap:10px;
      min-height:220px;
    }

    .cardTop{ display:flex; justify-content:space-between; gap:12px; align-items:flex-start; }
    .jobTitle{ font-size:16px; font-weight:650; color:#0f172a; text-decoration:none; }
    .jobTitle:hover{ text-decoration:underline; text-decoration-color: rgba(15,118,110,.35); }
    .jobSub{ margin-top:6px; color:#64748b; font-size:13px; line-height:1.5; }
    .dot{ margin:0 6px; color:#cbd5e1; }

    .tag{
      border:1px solid rgba(15,118,110,.25);
      background:#ccfbf1;
      color:#064e46;
      padding:6px 10px;
      font-size:12px;
      font-weight:650;
      white-space:nowrap;
    }

    .cardMid{ display:flex; gap:8px; flex-wrap:wrap; }
    .pill{
      border:1px solid #e5e7eb;
      padding:6px 10px;
      font-size:12px;
      font-weight:600;
      color:#0f172a;
      background:#fff;
    }

    .cardText{ margin:0; color:#64748b; font-size:13px; line-height:1.65; }
    .cardActions{ display:flex; gap:10px; margin-top:auto; flex-wrap:wrap; }

    @media (max-width: 980px){
      .grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .filters{ grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px){
      .wrap{ padding:22px 16px 64px; }
      .top{ flex-direction:column; align-items:flex-start; }
      .grid{ grid-template-columns: 1fr; }
      .filters{ grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
