---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { jobs } from "../../data/jobs";


const featured = jobs.slice(0, 3);
---

<BaseLayout title="Jhub — Jobs in Nigeria">
  <div class="wrap">
    <!-- HERO -->
    <section class="hero">
      <div class="heroText">
        <div class="kicker">Nigeria job feed</div>
        <h1>Find jobs in Nigeria — fast, clean, and shareable.</h1>
        <p class="lead">
          Jhub helps you discover roles, share them to WhatsApp, and apply faster using Apply Kit.
          No noise. Just opportunities.
        </p>

        <div class="ctaRow">
          <a class="btn teal" href="/jobs">Browse jobs</a>
          <a class="btn ghost" href="/tools/apply">Open Apply Kit</a>
        </div>

        <div class="miniMeta">
          <span class="dot">•</span> <span>{jobs.length}+ roles</span>
          <span class="dot">•</span> <span>Weekly updates</span>
          <span class="dot">•</span> <span>WhatsApp-ready</span>
        </div>
      </div>

      <aside class="heroPanel" aria-label="Featured jobs">
        <div class="panelTop">
          <div class="panelTitle">Featured roles</div>
          <a class="panelLink" href="/jobs">See all</a>
        </div>

        <div class="panelList">
          {featured.map((j) => (
            <a class="miniCard" href={`/jobs/${j.slug}`}>
              <div class="miniRow">
                <div class="miniTitle">{j.title}</div>
                <span class="tag">{j.workMode}</span>
              </div>
              <div class="miniSub">
                {j.company} <span class="dot">•</span> {j.location}
              </div>
              <div class="miniPills">
                <span class="pill">{j.level}</span>
                <span class="pill">Deadline: {j.deadline}</span>
              </div>
            </a>
          ))}
        </div>
      </aside>
    </section>

    <!-- ABOUT -->
    <section class="section" id="about">
      <div class="sectionHead">
        <h2>About Jhub</h2>
        <p>
          Jhub is a lightweight job board built for Nigeria. We keep listings clear and actionable,
          so you can move from discovery → application with less stress.
        </p>
      </div>

      <div class="cols3">
        <div class="infoCard">
          <div class="infoTitle">Clean listings</div>
          <p>No clutter, no distractions — just the details you need.</p>
        </div>
        <div class="infoCard">
          <div class="infoTitle">Share to WhatsApp</div>
          <p>Copy a ready message and post to your WhatsApp channel instantly.</p>
        </div>
        <div class="infoCard">
          <div class="infoTitle">Apply Kit</div>
          <p>Generate a cover letter + email draft faster when you’re ready to apply.</p>
        </div>
      </div>
    </section>

    <!-- HIRING PROCESS -->
    <section class="section" id="hiring-process">
      <div class="sectionHead">
        <h2>Hiring process (what to expect)</h2>
        <p>
          Most roles follow a similar path. Use this to plan your time and keep your documents ready.
        </p>
      </div>

      <div class="timeline">
        <div class="step">
          <div class="stepNo">1</div>
          <div class="stepBody">
            <div class="stepTitle">Find the right role</div>
            <p>Pick roles that match your skills, level, and location.</p>
          </div>
        </div>

        <div class="step">
          <div class="stepNo">2</div>
          <div class="stepBody">
            <div class="stepTitle">Tailor your application</div>
            <p>Use Apply Kit to craft a clear, relevant cover letter and email.</p>
          </div>
        </div>

        <div class="step">
          <div class="stepNo">3</div>
          <div class="stepBody">
            <div class="stepTitle">Interviews & assessments</div>
            <p>Expect a recruiter screen, task/assessment, then final interviews.</p>
          </div>
        </div>

        <div class="step">
          <div class="stepNo">4</div>
          <div class="stepBody">
            <div class="stepTitle">Offer & onboarding</div>
            <p>Negotiate politely, confirm expectations, then onboard smoothly.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section" id="how-it-works">
      <div class="sectionHead">
        <h2>How it works</h2>
        <p>Post once on Jhub — share to WhatsApp — apply easily. That’s the loop.</p>
      </div>

      <div class="howGrid">
        <div class="howCard">
          <div class="howTop">
            <div class="howBadge">Step 1</div>
            <div class="howTitle">Browse</div>
          </div>
          <p>Visit the Jobs page and filter by level, work mode, and location (coming next).</p>
          <a class="inlineLink" href="/jobs">Go to jobs →</a>
        </div>

        <div class="howCard">
          <div class="howTop">
            <div class="howBadge">Step 2</div>
            <div class="howTitle">Share</div>
          </div>
          <p>Open any job, copy the WhatsApp text, and post to your WhatsApp channel.</p>
          <a class="inlineLink" href="/jobs">Try on a job →</a>
        </div>

        <div class="howCard">
          <div class="howTop">
            <div class="howBadge">Step 3</div>
            <div class="howTitle">Apply</div>
          </div>
          <p>Use Apply Kit to generate your email + cover letter and apply quickly.</p>
          <a class="inlineLink" href="/tools/apply">Open Apply Kit →</a>
        </div>
      </div>
    </section>

    <!-- CASE STUDIES -->
    <section class="section" id="case-studies">
      <div class="sectionHead">
        <h2>Case studies</h2>
        <p>
          Short examples of how people apply faster with structure. We’ll replace these with real stories as we grow.
        </p>
      </div>

      <div class="cases">
        <article class="case">
          <div class="caseTitle">Entry-level applicant</div>
          <p>
            Used Jhub to find roles with clear deadlines and applied to 10 roles in one week using a reusable cover letter structure.
          </p>
          <div class="caseMeta">Outcome: more replies, less stress.</div>
        </article>

        <article class="case">
          <div class="caseTitle">Mid-level remote seeker</div>
          <p>
            Filtered to remote roles, used WhatsApp share text to track saved roles, then applied with tailored emails from Apply Kit.
          </p>
          <div class="caseMeta">Outcome: faster submissions.</div>
        </article>

        <article class="case">
          <div class="caseTitle">Career switch</div>
          <p>
            Focused on transferable skills, used the Hiring Process guide to prepare for assessments and interviews.
          </p>
          <div class="caseMeta">Outcome: better interview confidence.</div>
        </article>
      </div>
    </section>
  </div>

  <style>
    .wrap { max-width: 1240px; margin: 0 auto; }

    /* HERO */
    .hero {
      display: grid;
      grid-template-columns: 1.25fr 0.9fr;
      gap: 18px;
      padding-top: 10px;
    }

    .kicker {
      font-size: 12px;
      font-weight: 650;
      color: var(--teal);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    h1 {
      margin: 10px 0 0;
      font-size: 42px;
      line-height: 1.08;
      font-weight: 720;
      letter-spacing: -0.02em;
      color: var(--ink);
      max-width: 20ch;
    }

    .lead {
      margin-top: 12px;
      max-width: 65ch;
    }

    .ctaRow { margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap; }

    .miniMeta {
      margin-top: 14px;
      color: var(--muted);
      font-size: 13px;
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }
    .dot { color: #cbd5e1; }

    .heroPanel {
      border: 1px solid var(--border);
      background: #fff;
      padding: 14px;
      align-self: start;
    }

    .panelTop {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }
    .panelTitle { font-weight: 700; color: var(--ink); }
    .panelLink { font-weight: 650; }

    .panelList { display: grid; gap: 10px; margin-top: 12px; }

    .miniCard {
      border: 1px solid var(--border);
      padding: 12px;
      background: #fff;
      text-decoration: none;
      display: block;
    }
    .miniCard:hover { border-color: #cbd5e1; }

    .miniRow { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
    .miniTitle { color: var(--ink); font-weight: 700; font-size: 14px; }
    .miniSub { margin-top: 6px; color: var(--muted); font-size: 13px; }

    .tag {
      border: 1px solid rgba(15, 118, 110, 0.25);
      background: var(--teal-soft);
      color: var(--teal-ink);
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .miniPills { margin-top: 10px; display: flex; gap: 8px; flex-wrap: wrap; }
    .pill {
      border: 1px solid var(--border);
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 600;
      color: var(--ink);
      background: #fff;
    }

    /* SHARED */
    .section { margin-top: 42px; padding-top: 18px; border-top: 1px solid var(--border); }
    .sectionHead { display: grid; gap: 10px; max-width: 80ch; }
    h2 { margin: 0; font-size: 26px; font-weight: 700; color: var(--ink); }

    .btn {
      border: 1px solid var(--border);
      padding: 10px 12px;
      font-weight: 650;
      background: #fff;
      color: var(--ink);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .btn:hover { border-color: #cbd5e1; text-decoration: none; }
    .btn.teal { border-color: var(--teal); background: var(--teal); color: #fff; }
    .btn.ghost { background: #fff; }

    /* ABOUT */
    .cols3 {
      margin-top: 14px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 12px;
    }
    .infoCard {
      border: 1px solid var(--border);
      background: #fff;
      padding: 14px;
    }
    .infoTitle { font-weight: 700; color: var(--ink); margin-bottom: 6px; }

    /* TIMELINE */
    .timeline { margin-top: 14px; display: grid; gap: 10px; }
    .step {
      border: 1px solid var(--border);
      background: #fff;
      padding: 14px;
      display: grid;
      grid-template-columns: 38px 1fr;
      gap: 12px;
      align-items: start;
    }
    .stepNo {
      width: 38px; height: 38px;
      border: 1px solid rgba(15,118,110,.25);
      background: var(--teal-soft);
      color: var(--teal-ink);
      display: grid;
      place-items: center;
      font-weight: 800;
    }
    .stepTitle { font-weight: 700; color: var(--ink); }
    .stepBody p { margin: 6px 0 0; }

    /* HOW */
    .howGrid {
      margin-top: 14px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 12px;
    }
    .howCard {
      border: 1px solid var(--border);
      background: #fff;
      padding: 14px;
    }
    .howTop { display: flex; gap: 10px; align-items: baseline; }
    .howBadge { font-size: 12px; font-weight: 750; color: var(--teal); }
    .howTitle { font-weight: 750; color: var(--ink); }
    .inlineLink { font-weight: 650; }

    /* CASES */
    .cases {
      margin-top: 14px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 12px;
    }
    .case {
      border: 1px solid var(--border);
      background: #fff;
      padding: 14px;
    }
    .caseTitle { font-weight: 750; color: var(--ink); }
    .caseMeta { margin-top: 10px; font-size: 13px; color: var(--muted); font-weight: 600; }

    /* RESPONSIVE */
    @media (max-width: 980px) {
      .hero { grid-template-columns: 1fr; }
      .cols3, .howGrid, .cases { grid-template-columns: 1fr; }
      h1 { font-size: 38px; max-width: 28ch; }
    }
  </style>
</BaseLayout>
