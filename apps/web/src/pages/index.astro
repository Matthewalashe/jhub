---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout title="Jhub — Your Skills. Global Opportunities.">
  <Hero />

  <div class="wrap">
    <!-- the rest of your sections stay inside wrap -->
    <!-- ABOUT, HIRING PROCESS, HOW IT WORKS, CASE STUDIES, etc -->
  </div>

  <style>
    .wrap { max-width: 1240px; margin: 0 auto; padding: 0 22px; }
    @media (max-width: 640px){
      .wrap { padding: 0 16px; }
    }
  </style>
</BaseLayout>
