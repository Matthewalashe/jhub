---
import BaseLayout from "../../layouts/BaseLayout.astro";

const tools = [
  {
    title: "Apply Kit",
    desc: "Save your profile once. Generate a job-specific cover letter. Open email prefilled.",
    href: "/tools/apply",
    accent: "teal"
  },
  {
    title: "Resume Builder",
    desc: "Build a clean one-page resume from your saved profile. (Next step)",
    href: "/tools/apply#resume",
    accent: "gold"
  },
  {
    title: "Cover Letter Generator",
    desc: "Generate a reusable cover letter template you can edit per job. (Next step)",
    href: "/tools/apply#cover",
    accent: "pink"
  }
];

function dotColor(accent) {
  if (accent === "teal") return "var(--teal)";
  if (accent === "gold") return "var(--gold)";
  return "var(--pink)";
}
---

<BaseLayout title="Tools — Jhub">
  <section style="display:flex; flex-direction:column; gap:10px;">
    <div class="chip">
      <span class="dot" style={`background:${dotColor("teal")};`}></span>
      Tools
    </div>

    <h1 style="margin:0; font-size:28px; line-height:1.15; letter-spacing:-0.02em;">
      Utilities that help you apply faster
    </h1>

    <div class="muted" style="max-width:80ch; line-height:1.6;">
      Jhub isn’t just a job feed — it’s your application assistant. Save details once and reuse them across jobs.
    </div>

    <div class="row" style="margin-top:6px;">
      <a class="btn btn-teal" href="/tools/apply">Open Apply Kit</a>
      <a class="btn btn-gold" href="/jobs">Browse jobs</a>
    </div>
  </section>

  <section style="margin-top:18px; display:grid; gap:12px;">
    {tools.map((t) => (
      <a href={t.href} style="display:block;">
        <div class="card" style="padding:16px;">
          <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:flex-start;">
            <div style="min-width: 260px;">
              <div style="display:flex; align-items:center; gap:10px;">
                <span class="dot" style={`background:${dotColor(t.accent)}; width:10px; height:10px;`}></span>
                <div style="font-weight:900; letter-spacing:-0.01em;">
                  {t.title}
                </div>
              </div>

              <div class="muted" style="margin-top:8px; line-height:1.6; max-width: 85ch;">
                {t.desc}
              </div>
            </div>

            <div style="font-weight:900; color:var(--teal);">
              Open →
            </div>
          </div>
        </div>
      </a>
    ))}
  </section>

  <section class="card" style="margin-top:16px; padding:16px;">
    <div style="font-weight:900;">How it works</div>

    <ol style="margin:10px 0 0; padding-left:18px; line-height:1.9;">
      <li>Open Apply Kit and save your profile.</li>
      <li>Select a job (or open Apply Kit from a specific job page).</li>
      <li>Generate cover letter, then open email prefilled.</li>
      <li>Attach your resume and send.</li>
    </ol>

    <div class="muted" style="margin-top:10px; font-size:12px;">
      Next upgrade: export Resume + Cover Letter as PDF so users attach in one click.
    </div>
  </section>
</BaseLayout>
