---
import Header from "../components/Header.astro";

const { title = "Jhub", description = "Jobs, tools, and learning for Nigeria." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>
