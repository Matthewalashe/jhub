---
const { title = "Jhub" } = Astro.props;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>

  <style>
    :root{
      --bg:#ffffff;
      --surface:#ffffff;
      --ink:#0f172a;
      --muted:#64748b;
      --line:#e2e8f0;

      --teal:#14b8a6;
      --pink:#fb7185;
      --gold:#fbbf24;

      --pad:44px;
      --max:1120px;
    }

    *{ box-sizing:border-box; }
    html, body{ height:100%; }
    body{
      margin:0;
      background:var(--bg);
      color:var(--ink);
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      overflow-x:hidden;
    }

    a, a:visited{ color:inherit; text-decoration:none; }
    a:hover{ text-decoration:none; }

    .wrap{
      width:100%;
      padding-left:var(--pad);
      padding-right:var(--pad);
    }
    .container{
      max-width:var(--max);
      margin:0 auto;
      width:100%;
    }

    @media (max-width: 900px){
      :root{ --pad:18px; }
    }

    .row{ display:flex; gap:12px; flex-wrap:wrap; min-width:0; align-items:center; }

    .muted{ color:var(--muted); }

    .chip{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:6px 10px;
      border:1px solid var(--line);
      border-radius:0;
      font-size:12px;
      color:var(--muted);
      background:var(--surface);
    }
    .dot{ width:10px; height:10px; display:inline-block; }

    .card{
      border:1px solid var(--line);
      border-radius:0;
      background:var(--surface);
    }
    .card:hover{
      border-color:#cbd5e1;
      background:#fcfcfd;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      padding:10px 12px;
      border-radius:0;
      border:1px solid var(--line);
      background:var(--surface);
      font-weight:800;
      cursor:pointer;
    }
    .btn-teal{ border-color: rgba(20,184,166,.35); }
    .btn-pink{ border-color: rgba(251,113,133,.35); }
    .btn-gold{ border-color: rgba(251,191,36,.35); }

    input, textarea, select{ font: inherit; }
  </style>
</head>

<body>
  <header style="border-bottom:1px solid var(--line); background:var(--surface);">
    <div class="wrap">
      <div class="container" style="height:64px; display:flex; align-items:center; justify-content:space-between;">
        <a href="/" style="font-weight:900; letter-spacing:-0.02em;">Jhub</a>

        <nav class="row" style="gap:18px; font-size:14px;">
          <a href="/jobs">Jobs</a>
          <a href="/news">News</a>
          <a href="/newsletter">Newsletter</a>
          <a href="/tools">Tools</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="wrap" style="padding-top:24px; padding-bottom:60px;">
    <div class="container">
      <slot />
    </div>
  </main>
</body>
</html>
