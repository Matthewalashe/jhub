---
import BaseLayout from "../../layouts/BaseLayout.astro";

const jobs = [
  {
    slug: "frontend-developer-example-company",
    title: "Frontend Developer",
    company: "Example Company",
    location: "Lagos",
    level: "Entry",
    workMode: "Hybrid",
    deadline: "Feb 28, 2026",
    summary: "Build and maintain responsive UI for a fast-growing product team."
  },
  {
    slug: "product-designer-startup-ng",
    title: "Product Designer",
    company: "Startup NG",
    location: "Remote (Nigeria)",
    level: "Mid",
    workMode: "Remote",
    deadline: "Mar 5, 2026",
    summary: "Design end-to-end flows and improve UX across mobile and web."
  },
  {
    slug: "data-analyst-fintech-lagos",
    title: "Data Analyst",
    company: "Fintech Lagos",
    location: "Lagos",
    level: "Entry",
    workMode: "On-site",
    deadline: "Mar 1, 2026",
    summary: "Analyze product and business data to generate insights and reports."
  }
];
---

<BaseLayout title="Jobs — Jhub">
  <section style="display:flex; flex-direction:column; gap:10px;">
    <div class="chip">
      <span class="dot" style="background:var(--teal);"></span>
      Nigeria job feed
    </div>

    <h1 style="margin:0; font-size:28px; line-height:1.15; letter-spacing:-0.02em;">
      Open Positions
    </h1>

    <div class="muted" style="max-width:75ch; line-height:1.6;">
      Plain, clean listings. Post once on Jhub — share to WhatsApp — apply easily.
    </div>

    <div class="row" style="margin-top:6px;">
      <a class="btn btn-teal" href="/newsletter">
        Weekly digest
      </a>
      <a class="btn btn-pink" href="/tools/apply">
        Resume & cover tools
      </a>
    </div>
  </section>

  <section style="margin-top:18px; display:grid; gap:12px;">
    {jobs.map((j) => (
      <a href={`/jobs/${j.slug}`} style="display:block;">
        <div class="card" style="padding:14px;">
          <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:flex-start;">
            <div style="min-width:260px;">
              <div style="font-weight:900; letter-spacing:-0.01em;">
                {j.title}
              </div>
              <div class="muted" style="margin-top:6px; font-size:13px;">
                {j.company} • {j.location}
              </div>
            </div>

            <div class="row" style="gap:8px; justify-content:flex-end;">
              <span class="chip">
                <span class="dot" style="background:var(--gold);"></span>
                {j.workMode}
              </span>

              <span class="chip">
                <span class="dot" style="background:var(--pink);"></span>
                {j.level}
              </span>

              <span class="chip">
                <span class="dot" style="background:var(--teal);"></span>
                Deadline: {j.deadline}
              </span>
            </div>
          </div>

          <div class="muted" style="margin-top:10px; line-height:1.55; max-width: 90ch;">
            {j.summary}
          </div>

          <div style="margin-top:10px; font-weight:900; color:var(--teal);">
            View details →
          </div>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
